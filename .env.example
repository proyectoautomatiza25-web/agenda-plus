# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/
# Steps:
# 1. Go to Account -> General -> Copy Service ID
# 2. Go to Email Templates -> Copy Template ID
# 3. Go to Account -> General -> Copy Public Key

# Service ID - Del servicio de email que conectaste (Gmail, Outlook, etc.)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxxx

# Template ID - Del template de email de bienvenida que creaste
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxx

# Public Key - De tu cuenta de EmailJS (Account -> General -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# INSTRUCCIONES:
# 1. Copia este archivo como .env.local
# 2. Reemplaza los valores con tus credenciales reales de EmailJS
# 3. NO subas .env.local a Git (ya está en .gitignore)
# 4. En producción (Vercel, etc.), agrega estas variables en el dashboard

# TROUBLESHOOTING:
# - Si EmailJS no funciona, revisa que las variables estén correctas
# - Abre la consola del navegador (F12) para ver mensajes de error
# - Si ves "DEMO_SERVICE_ID", significa que faltan las variables de entorno
